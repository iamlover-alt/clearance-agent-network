{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamlover-alt/clearance-agent-network/integration/schema.json",
  "title": "ClearanceRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief",
    "agentIds"
  ],
  "properties": {
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "agentIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "commit": {
      "type": "string"
    }
  }
}
